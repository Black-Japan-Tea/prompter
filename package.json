{
  "name": "prompter",
  "productName": "Prompter",
  "version": "1.5.0",
  "description": "Markdown teleprompter invisible to screen sharing",
  "author": "Jobka",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "tsc -p tsconfig.json && node dist/tools/generate-icons.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.3.0",
    "dompurify": "^3.4.14",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "markdown-it": "^15.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
